# Configuration for Railway Passenger Help Desk AI
# Copy this file to .env and adjust variables as needed

# Document paths
DOCS_DIR=documents
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=rail_helpdesk_docs

# Embedding Model Configuration (HuggingFace BAAI/bge-small-en-v1.5, 384 dimensions)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval & Search
TOP_K=4

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timetable Database (Read-Only SQLite)
TIMETABLE_DB_PATH=database/rail_timetable.db
